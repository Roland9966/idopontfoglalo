APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/idopontfoglalo_rendszer/public
APP_TIMEZONE=Europe/Belgrade
CANCELLATION_HOURS=24
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=idopontfoglalo
DB_USER=root
DB_PASS=

# log: a leveleket a storage/mail.log fájlba írja
# smtp: valódi levelet küld az alábbi SMTP-beállításokkal
# mail: a PHP mail() függvényét használja
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@iskola.local
MAIL_FROM_NAME=Időpontfoglaló

# Gmail használatakor: smtp.gmail.com, 587, tls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=20
